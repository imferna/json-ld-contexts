{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "i3b-credentials": "https://w3id.org/i3b-mvd/credentials/",
    "MembershipCredential": {
      "@id": "i3b-credentials:MembershipCredential"
    },
    "ManufacturerCredential": {
      "@id": "i3b-credentials:ManufacturerCredential"
    },
    "MaasPlatformCredential": {
      "@id": "i3b-credentials:MaasPlatformCredential"
    },
    "membership": {
      "@id": "i3b-credentials:membership"
    },
    "membershipType": {
      "@id": "i3b-credentials:membershipType",
      "@type": "xsd:string"
    },
    "membershipStartDate": {
      "@id": "i3b-credentials:membershipStartDate",
      "@type": "xsd:dateTime"
    },
    "contractVersion": {
      "@id": "i3b-credentials:contractVersion",
      "@type": "xsd:string"
    },
    "part_types": {
      "@id": "i3b-credentials:part_types",
      "@type": "xsd:string"
    },
    "since": {
      "@id": "i3b-credentials:since",
      "@type": "xsd:dateTime"
    },
    "role": {
      "@id": "i3b-credentials:role",
      "@type": "xsd:string"
    },
    "group": {
      "@id": "i3b-credentials:group",
      "@type": "xsd:string"
    },
    "useCase": {
      "@id": "i3b-credentials:useCase",
      "@type": "xsd:string"
    },
    "contractTemplate": {
      "@id": "i3b-credentials:contractTemplate",
      "@type": "xsd:string"
    },
    "holderIdentifier": {
      "@id": "i3b-credentials:holderIdentifier",
      "@type": "xsd:string"
    }
  }
}
