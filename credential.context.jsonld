{
    "@context": {
        "@version": 1.1,
        "@protected": true,
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "gx": "https://registry.lab.gaia-x.eu/development/api/trusted-shape-registry/v1/shapes/jsonld/trustframework#",
        "i3b-credentials": "https://w3id.org/i3b-mvd/credentials/",
        "DataProcessorCredential": {
            "@id": "i3b-credentials:DataProcessorCredential"
        },
        "MembershipCredential": {
            "@id": "i3b-credentials:MembershipCredential"
        },
        "TraceabilityCredential": {
            "@id": "i3b-credentials:TraceabilityCredential"
        },
        "TrustedObserverCredential": {
            "@id": "i3b-credentials:TrustedObserverCredential"
        },
        "membership": {
            "@id": "i3b-credentials:membership",
            "@type": "@id"
        },
        "bpn": {
            "@id": "i3b-credentials:businessPartnerNumber",
            "@type": "xsd:string"
        },
        "membershipType": {
            "@id": "i3b-credentials:membershipType",
            "@type": "xsd:string"
        },
        "since": {
            "@id": "i3b-credentials:since",
            "@type": "xsd:string"
        },
        "ownedBy": {
            "@id": "i3b-credentials:ownedBy",
            "@type": "@id"
        },
        "hash": "gx:hash",
        "contractVersion": {
            "@id": "mvd-credentials:contractVersion",
            "@type": "xsd:string"
        },
        "level": {
            "@id": "mvd-credentials:level",
            "@type": "xsd:string"
        }
    }
}
